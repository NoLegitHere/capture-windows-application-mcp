{
  "name": "capture-windows-application-mcp",
  "version": "1.1.0",
  "description": "Plugin-ready MCP server for launching and capturing visible Windows application windows.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "capture-windows-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "scripts/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.json",
    "plugin.json"
  ],
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js && xcopy /E /Y /I src\\scripts dist\\scripts",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1"
  },
  "keywords": [
    "mcp",
    "windows",
    "screenshot",
    "agent-skill",
    "claude-code",
    "github-copilot",
    "codex",
    "opencode"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
