{
  "name": "capture-windows-application-mcp",
  "version": "1.1.0",
  "description": "Plugin-ready MCP server for launching and capturing visible Windows application windows.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "capture-windows-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && xcopy /E /Y /I src\\scripts dist\\scripts",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "windows",
    "screenshot",
    "agent-skill",
    "claude-code",
    "github-copilot",
    "codex",
    "opencode"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
